# Live installer environment package set (the ISO's own root filesystem, NOT
# the installed system — that comes from install/packages.txt + the base set
# pacstrap'd by foundation-install). Keep this lean: it exists to run one
# installer script on a kernel VT.

# boot/kernel — linux-lts to match the OS itself (spec §1)
base
linux-lts
# Firmware: same default-set-minus-nvidia as install/packages.txt (2026-07-07,
# size). The live installer boots on the same Intel/AMD mini-PC target, so it
# needs the same consumer firmware and not the ~99 MB discrete-NVIDIA blob. Keep
# this list in sync with install/packages.txt's firmware block.
linux-firmware-amdgpu
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-cirrus
linux-firmware-intel
linux-firmware-mediatek
linux-firmware-other
linux-firmware-radeon
linux-firmware-realtek
linux-firmware-whence
mkinitcpio
mkinitcpio-archiso

# installer tooling
arch-install-scripts
gptfdisk
dosfstools
e2fsprogs

# bootloader install on the target (both firmware types)
grub
efibootmgr

# the live medium's own BIOS bootloader (archiso's bios.syslinux.* modes pull
# the binaries from this package inside the live rootfs)
syslinux

# optional network fallback (only needed if the ISO was built without the
# embedded offline package repo) + rescue-shell comfort
networkmanager

# console look, same phosphor font the OS uses
terminus-font
