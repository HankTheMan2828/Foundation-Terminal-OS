#!/usr/bin/env bash
# foundation-install — runs on the live ISO's console and turns the machine in
# front of you into Foundation TerminalOS.
#
# Flow (one screenful at a time, same register as the OS itself):
#   0. if a Foundation TerminalOS install already exists on a disk, offer
#      UPDATE (docs/UPDATE-SYSTEM.md §4): refresh the OS from this medium,
#      preserving /home, accounts, Settings choices, and ALL Frank state —
#      no partitioning, nothing formatted
#   1. optional hardware profile (default: generic core — any x86_64 box)
#   2. pick the target disk from a menu — the ONE destructive step,
#      gated behind typing ERASE in full
#   3. hostname + root password
#   4. partition, pacstrap from the ISO's embedded offline package repo
#      (network fallback if the ISO was built without one), copy this repo to
#      /opt/terminal-os on the target, run install/run-all.sh in the chroot,
#      install GRUB (UEFI or BIOS), reboot
#
# The installed system never depends on the install-time machine: paths are
# recorded/searched (see /etc/foundationhub/install-root), the operator's home
# is resolved from the passwd db, and the generic core assumes no device.
# -E so the ERR trap fires for failures inside main() (function bodies don't
# inherit the trap without errtrace).
set -Eeuo pipefail

REPO=/opt/terminal-os                 # embedded by image/build-iso.sh
PKGREPO=/opt/foundation/pkgs          # embedded offline package repo (optional)
MNT=/mnt
LOG=/root/foundation-install.log

# ── the terminal voice ───────────────────────────────────────────────────────
c_info()  { printf '\033[1;33m[*]\033[0m %s\n' "$*"; }
c_ok()    { printf '\033[1;32m[+]\033[0m %s\n' "$*"; }
c_warn()  { printf '\033[1;31m[!]\033[0m %s\n' "$*"; }
c_step()  { printf '\n\033[1;36m=== %s ===\033[0m\n' "$*"; }

# masked password prompt: echoes a * per keystroke (backspace works), so the
# user can see typing is registering without exposing the password
read_password() {
  local prompt="$1" __outvar="$2" ch pw=""
  printf '%s' "$prompt"
  while IFS= read -rs -n1 ch; do
    [[ -z "$ch" ]] && break                                  # Enter
    if [[ "$ch" == $'\x7f' || "$ch" == $'\x08' ]]; then      # Backspace
      [[ -n "$pw" ]] && { pw="${pw%?}"; printf '\b \b'; }
    else
      pw+="$ch"
      printf '*'
    fi
  done
  echo
  printf -v "$__outvar" '%s' "$pw"
}

banner() {
  clear || true
  printf '\033[1;33m'
  cat <<'EOF'
  ┌──────────────────────────────────────────────────────────────┐
  │             FOUNDATION  TERMINALOS  —  INSTALLER             │
  │                     "From the Foundation."                   │
  └──────────────────────────────────────────────────────────────┘
EOF
  printf '\033[0m'
  echo "  This medium installs a locked-down, no-shell kiosk OS with an"
  echo "  always-on overseer (Frank). Ctrl-Alt-F2 gives a rescue shell."
  echo
}

on_error() {
  c_warn "installer stopped on an error (see above; log: $LOG)"
  c_warn "the target may still be mounted at $MNT — you are in the live"
  c_warn "environment, nothing on this machine boots differently yet."
  c_warn "fix and rerun with:  foundation-install"
}
trap on_error ERR

# The disk we booted from — never a target for anything.
detect_live_disk() {
  local live_src live_disk=""
  live_src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -n "$live_src" && -b "$live_src" ]]; then
    live_disk="$(lsblk -no pkname "$live_src" 2>/dev/null | head -1 || true)"
    # A dd'd ISO may be mounted from the whole device, not a partition —
    # pkname is empty then, and the device itself is the disk to exclude.
    [[ -z "$live_disk" ]] && live_disk="$(basename "$live_src")"
  fi
  echo "$live_disk"
}

# ── Frank local AI: raw-offset sidecar on the USB → dest repo vendor/ ─────────
# The USB creator wrote [FOUNDATIONAI2 header][model][server] as RAW bytes past
# the ISO (STAGE_OFFSET = 2 GiB). Absolute offsets in the header are the contract
# shared by Create-FoundationUSB.ps1, create-foundation-usb.sh, and this reader
# (docs/FRANK-LOCAL-AI.md).
#
# CRITICAL: always write into the *target* tree ($MNT/opt/terminal-os/…), never
# the live ISO's /opt/terminal-os. The live root is an overlay on tmpfs — dumping
# a ~1.2 GB GGUF there can OOM the installer and then double-copy on cp -a.
# install/11-frank-ai.sh reads dest/vendor/{models,bitnet}/ on the installed box.
STAGE_OFFSET=2147483648   # 2 GiB — keep in sync with the USB creators
stage_frank_ai() {
  local disk_name="$1" dest="$2"
  local disk="/dev/${disk_name}"
  [[ -n "$disk_name" && -b "$disk" ]] || {
    c_info "live USB device not found — Frank runs rule-based (AI idle)"; return 0; }
  [[ -n "$dest" && -d "$dest" ]] || {
    c_warn "AI stage dest missing ($dest) — skipping"; return 0; }

  local hdr
  # Header lives at the fixed offset; first 4 KiB always carries the text
  # (Windows writer uses a 4 KiB header region; Linux uses 1 MiB — same start).
  hdr="$(dd if="$disk" bs=4096 skip=$((STAGE_OFFSET / 4096)) count=1 2>/dev/null | tr -d '\000')"
  if [[ "$hdr" != FOUNDATIONAI2* ]]; then
    c_info "no staged AI payload on the USB — Frank runs rule-based (AI idle)"
    return 0
  fi

  local mo ms so ss
  mo="$(printf '%s\n' "$hdr" | sed -n 's/^model_offset=//p'  | head -1)"
  ms="$(printf '%s\n' "$hdr" | sed -n 's/^model_size=//p'    | head -1)"
  so="$(printf '%s\n' "$hdr" | sed -n 's/^server_offset=//p' | head -1)"
  ss="$(printf '%s\n' "$hdr" | sed -n 's/^server_size=//p'   | head -1)"
  [[ "$mo" =~ ^[0-9]+$ && "$ms" =~ ^[0-9]+$ && "$ms" -gt 0 ]] || {
    c_warn "AI header unreadable — skipping"; return 0; }
  # Sanity bounds: model must start past the header region, size under 4 GiB.
  if (( mo < STAGE_OFFSET + 4096 || ms > 4294967296 )); then
    c_warn "AI header offsets look wrong (mo=$mo ms=$ms) — refusing to stage"
    return 0
  fi

  mkdir -p "$dest/vendor/models" "$dest/vendor/bitnet"
  local model_out="$dest/vendor/models/model.gguf"
  local server_out="$dest/vendor/bitnet/llama-server"

  c_info "reading staged AI model from USB ($ms bytes)…"
  if ! dd if="$disk" of="$model_out" bs=1M iflag=skip_bytes,count_bytes \
        skip="$mo" count="$ms" status=none 2>/dev/null; then
    c_warn "could not read the staged model — skipping"; rm -f "$model_out"; return 0
  fi
  # Exact size check (header is the source of truth; padding on the stick is ignored).
  local got
  got="$(stat -c %s "$model_out" 2>/dev/null || stat -f %z "$model_out" 2>/dev/null || echo 0)"
  if [[ "$got" != "$ms" ]]; then
    c_warn "staged model size mismatch (got $got, expected $ms) — discarding"
    rm -f "$model_out"; return 0
  fi
  # GGUF magic ("GGUF") — catch a truncated/corrupt dd early.
  local magic
  magic="$(dd if="$model_out" bs=1 count=4 2>/dev/null || true)"
  if [[ "$magic" != "GGUF" ]]; then
    c_warn "staged model is not a GGUF file (bad magic) — discarding"
    rm -f "$model_out"; return 0
  fi
  c_ok "staged AI model from USB ($ms bytes) → $model_out"

  if [[ "$ss" =~ ^[0-9]+$ && "$ss" -gt 0 && "$so" =~ ^[0-9]+$ ]]; then
    if dd if="$disk" of="$server_out" bs=1M iflag=skip_bytes,count_bytes \
          skip="$so" count="$ss" status=none 2>/dev/null; then
      got="$(stat -c %s "$server_out" 2>/dev/null || stat -f %z "$server_out" 2>/dev/null || echo 0)"
      if [[ "$got" != "$ss" ]]; then
        c_warn "staged server size mismatch (got $got, expected $ss) — discarding binary"
        rm -f "$server_out"
      else
        # ELF magic — the prebuilt bitnet.cpp llama-server is a Linux ELF.
        magic="$(dd if="$server_out" bs=1 count=4 2>/dev/null || true)"
        if [[ "$magic" != $'\x7fELF' ]]; then
          c_warn "staged server is not an ELF binary — discarding"
          rm -f "$server_out"
        else
          chmod +x "$server_out"
          c_ok "staged AI server from USB ($ss bytes) → $server_out"
        fi
      fi
    else
      c_warn "could not read the staged AI server binary"
    fi
  else
    c_warn "USB has the model but no AI server binary — install/11 will leave"
    c_warn "frank-ai.service idle offline (no on-target build without network)."
  fi

  if [[ -f "$model_out" && -x "$server_out" ]]; then
    c_ok "AI payload ready for install/11-frank-ai.sh (local BitNet)"
  elif [[ -f "$model_out" ]]; then
    c_warn "partial AI payload (model only) — sensor stays idle until a server is present"
  fi
}

# An existing install's root partition (mkfs labels it foundation-root), or
# nothing. Probe-mounted read-only to confirm it is really ours.
# HARDWARE BUG (first mini-PC update, 2026-07-04): stdout here IS the return
# value — the caller command-substitutes it — and util-linux printed a mount
# warning ("Can't mount, would change RO state": the partition was still
# attached from an earlier errored run) that got captured as the "partition
# path", which do_update's mount then parsed as an NFS remote (it contained
# a colon). So: every command is silenced, an already-mounted partition is
# inspected in place instead of re-mounted, and the caller validates it got
# a block device.
find_existing_install() {
  local live_disk="$1" part probe mnted
  probe="$(mktemp -d /run/foundation-probe.XXXXXX)"
  while read -r part; do
    [[ -n "$part" ]] || continue
    [[ -n "$live_disk" && \
       "$(lsblk -no pkname "$part" 2>/dev/null | head -1)" == "$live_disk" ]] && continue
    mnted="$(findmnt -no TARGET "$part" 2>/dev/null | head -1 || true)"
    if [[ -n "$mnted" ]]; then
      # Already mounted (leftover of an earlier run) — look, don't re-mount.
      if [[ -e "$mnted$REPO/install/run-all.sh" ]]; then
        rmdir "$probe"; echo "$part"; return 0
      fi
      continue
    fi
    if mount -o ro "$part" "$probe" >/dev/null 2>&1; then
      if [[ -e "$probe$REPO/install/run-all.sh" ]]; then
        umount "$probe" >/dev/null 2>&1 || true
        rmdir "$probe" 2>/dev/null || true
        echo "$part"; return 0
      fi
      umount "$probe" >/dev/null 2>&1 || true
    fi
  done < <(lsblk -plno NAME,FSTYPE,LABEL |
           awk '$2 == "ext4" && $3 == "foundation-root" {print $1}')
  rmdir "$probe" 2>/dev/null || true
  return 1
}

# ── UPDATE mode (docs/UPDATE-SYSTEM.md §4) ───────────────────────────────────
# Refresh an existing install from this medium. No partitioning, nothing
# formatted; /home, accounts, Settings choices, and ALL Frank state survive
# (the install steps run in FOUNDATION_UPDATE=1 no-clobber mode — an active
# Frank lockout survives and re-arms after the reboot, by design §6).
do_update() {
  local part="$1"
  c_step "Update from this medium"
  # Clear leftovers from any earlier errored run — the ERR trap deliberately
  # leaves the target mounted for inspection, and a stale mount is exactly
  # what broke the first hardware update (see find_existing_install).
  umount -R "$MNT" 2>/dev/null || true
  local prior
  prior="$(findmnt -no TARGET "$part" 2>/dev/null | head -1 || true)"
  if [[ -n "$prior" && "$prior" != "$MNT" ]]; then
    umount -R "$prior" 2>/dev/null || true
  fi
  mount "$part" "$MNT"

  local cur_ver="unknown (pre-v0.0.3)" new_ver="unversioned"
  [[ -f "$MNT/etc/foundation-release" ]] && \
    cur_ver="$(sed -n 's/^version=//p' "$MNT/etc/foundation-release" | head -1)"
  [[ -f "$REPO/VERSION" ]] && \
    new_ver="$(sed -n 's/^version=//p' "$REPO/VERSION" | head -1)"

  echo "  installed on $part : $cur_ver"
  echo "  this medium        : $new_ver"
  [[ "$cur_ver" == "$new_ver" ]] && \
    c_warn "same version — continuing reapplies it (repairs a damaged install)"
  echo
  echo "This refreshes the OS and its packages. Your files, accounts, and"
  echo "settings are preserved. Nothing is formatted."
  local confirm
  read -rp "> type UPDATE (all caps) to continue, anything else aborts: " confirm
  [[ "$confirm" == "UPDATE" ]] || {
    c_info "aborted — nothing was touched"; umount -R "$MNT"; exit 0; }

  # Mount the target's /boot (ESP on UEFI) exactly as its fstab says.
  local bootspec
  bootspec="$(awk '$2 == "/boot" && $1 !~ /^#/ {print $1}' "$MNT/etc/fstab" | head -1)"
  [[ -n "$bootspec" ]] && mount "$bootspec" "$MNT/boot"

  # ── packages: move to this release's tested set, offline ──────────────────
  c_step "Upgrading packages from the embedded repo"
  local pkgs=(base archlinux-keyring mkinitcpio grub efibootmgr)
  mapfile -t -O "${#pkgs[@]}" pkgs < <(
    sed -E 's/#.*$//; s/[[:space:]]+$//; /^[[:space:]]*$/d' \
      "$REPO/install/packages.txt")
  local profile=""
  [[ -f "$MNT/etc/foundation-release" ]] && \
    profile="$(sed -n 's/^profile=//p' "$MNT/etc/foundation-release" | head -1)"
  if [[ -n "$profile" && -f "$REPO/profiles/$profile/packages.txt" ]]; then
    mapfile -t -O "${#pkgs[@]}" pkgs < <(
      sed -E 's/#.*$//; s/[[:space:]]+$//; /^[[:space:]]*$/d' \
        "$REPO/profiles/$profile/packages.txt")
  fi
  if [[ -f "$PKGREPO/foundation.db" ]]; then
    # arch-chroot mounts a fresh tmpfs over the target's /tmp and bind-mounts
    # the host's /run over the target's /run, so anything staged there before
    # the chroot is invisible inside it (that shadowing is what made pacman
    # report "/tmp/foundation-update-pacman.conf could not be read"). Stage the
    # repo bind and the pacman config under /var, which arch-chroot leaves
    # alone, so pacman can actually read both from inside the chroot.
    mkdir -p "$MNT/var/cache/foundation-pkgs"
    mount --bind "$PKGREPO" "$MNT/var/cache/foundation-pkgs"
    cat > "$MNT/var/tmp/foundation-update-pacman.conf" <<'EOF'
[options]
Architecture = x86_64
# The ISO's embedded mirror, bind-mounted into the target for the upgrade;
# populated at ISO build time from signed Arch mirrors (same trust story as
# install — see docs/OPEN-QUESTIONS.md §12).
SigLevel = Never
DisableSandbox

[foundation]
Server = file:///var/cache/foundation-pkgs
EOF
    # One transaction: upgrade everything installed AND pull in packages this
    # release newly added to packages.txt.
    arch-chroot "$MNT" pacman -Syu --needed --noconfirm \
      --config /var/tmp/foundation-update-pacman.conf "${pkgs[@]}"
    umount "$MNT/var/cache/foundation-pkgs"
    rmdir "$MNT/var/cache/foundation-pkgs" 2>/dev/null || true
    rm -f "$MNT/var/tmp/foundation-update-pacman.conf"
  else
    c_warn "no embedded package repo on this ISO — skipping package upgrade"
    c_warn "(OS payload still refreshes; packages stay as they are)"
  fi

  # ── OS payload: replace /opt/terminal-os (user data lives elsewhere) ───────
  c_step "Refreshing the OS payload"
  rm -rf "$MNT$REPO.prev"
  [[ -d "$MNT$REPO" ]] && mv "$MNT$REPO" "$MNT$REPO.prev"
  mkdir -p "$MNT$REPO"
  cp -a "$REPO/." "$MNT$REPO/"
  find "$MNT$REPO" -type f \
    \( -name '*.sh' -o -path '*/hardware/*' -o -path '*/usr/local/bin/*' \) \
    -exec chmod +x {} +

  # Stage AI onto the TARGET tree (same contract as a fresh install). If this
  # USB has no sidecar, an earlier install's model under /var/lib/frank/models
  # is left alone by install/11 (no-clobber when already present).
  c_step "Frank local AI (staged model, if present)"
  stage_frank_ai "$(detect_live_disk)" "$MNT$REPO"

  # ── re-run the install steps in no-clobber update mode ────────────────────
  c_step "Applying (install/run-all.sh, update mode)"
  arch-chroot "$MNT" /usr/bin/env \
    FOUNDATION_ASSUME_YES=1 FOUNDATION_OFFLINE=1 FOUNDATION_UPDATE=1 \
    HARDWARE_PROFILE="$profile" \
    "$REPO/install/run-all.sh"

  # ── bootloader: config always, install best-effort (kernel/GRUB bumps) ─────
  c_step "Bootloader"
  local disk="/dev/$(lsblk -no pkname "$part" | head -1)"
  if [[ -d /sys/firmware/efi/efivars ]]; then
    arch-chroot "$MNT" grub-install --target=x86_64-efi \
      --efi-directory=/boot --bootloader-id=FOUNDATION --removable \
      2>/dev/null || true
  else
    arch-chroot "$MNT" grub-install --target=i386-pc "$disk" 2>/dev/null || true
  fi
  arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg

  # ── done ───────────────────────────────────────────────────────────────────
  cp "$LOG" "$MNT/var/log/foundation-update.log" 2>/dev/null || true
  sync
  umount -R "$MNT"
  c_step "Update complete"
  echo "  installed: $new_ver (was: $cur_ver)"
  echo "  Remove the medium. Files, accounts, and Frank state were preserved."
  echo
  local ans
  read -rp "> press ENTER to reboot (or type s for a live shell): " ans
  [[ "${ans,,}" == "s" ]] || reboot
}

main() {
  exec > >(tee -a "$LOG") 2>&1
  banner
  [[ -d "$REPO/install" ]] || {
    c_warn "embedded repo missing at $REPO — was this ISO built by image/build-iso.sh?"
    exit 1
  }

  # ── 0. existing install? offer UPDATE (docs/UPDATE-SYSTEM.md §4) ──────────
  local live_disk existing=""
  live_disk="$(detect_live_disk)"
  existing="$(find_existing_install "$live_disk" || true)"
  # Belt and braces: only a real block device may reach do_update — anything
  # else means detection output got polluted, and offering UPDATE on it
  # would fail (or worse) at the mount.
  [[ -b "$existing" ]] || existing=""
  if [[ -n "$existing" ]]; then
    c_step "Existing installation found"
    echo "  Foundation TerminalOS is already installed on $existing."
    echo
    echo "  1) UPDATE it from this medium — files, accounts, and settings"
    echo "     are preserved; nothing is formatted"
    echo "  2) INSTALL fresh — ERASES a disk completely"
    local mode
    read -rp "> [1]: " mode
    if [[ "${mode:-1}" != "2" ]]; then
      do_update "$existing"
      return
    fi
    c_info "fresh install chosen — continuing to the standard flow"
  fi

  # ── 1. hardware profile ────────────────────────────────────────────────────
  c_step "Hardware profile"
  echo "The generic core targets any x86_64 machine (mini PCs included) and"
  echo "assumes no device. A profile adds glue for one specific device only."
  echo
  local profiles=() i=1
  local d
  for d in "$REPO"/profiles/*/; do
    [[ -d "$d" ]] && profiles+=("$(basename "$d")")
  done
  echo "  0) none — generic core (recommended for mini PCs)"
  for d in "${profiles[@]}"; do echo "  $i) $d"; i=$((i + 1)); done
  local pick profile=""
  read -rp "> profile [0]: " pick
  if [[ "$pick" =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#profiles[@]})); then
    profile="${profiles[$((pick - 1))]}"
    c_info "profile: $profile — check $REPO/profiles/$profile/README.md gates after install"
  else
    c_info "generic core only"
  fi

  # ── 2. target disk (the destructive step) ──────────────────────────────────
  c_step "Target disk"
  # Never offer the medium we booted from (live_disk found in step 0).
  local disks=() lines=() name size model
  while read -r name size model; do
    [[ -n "$name" ]] || continue
    [[ "$(basename "$name")" == "$live_disk" ]] && continue
    disks+=("$name")
    lines+=("$name  $size  ${model:-}")
  done < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF == "disk" {NF--; print}')

  if ((${#disks[@]} == 0)); then
    c_warn "no installable disks found (only the live medium is present)"
    exit 1
  fi
  echo "Every byte on the chosen disk will be destroyed."
  echo
  i=1
  local l
  for l in "${lines[@]}"; do echo "  $i) $l"; i=$((i + 1)); done
  local disk=""
  while [[ -z "$disk" ]]; do
    read -rp "> install to disk #: " pick
    if [[ "$pick" =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#disks[@]})); then
      disk="${disks[$((pick - 1))]}"
    fi
  done
  echo
  c_warn "TARGET: $disk — this disk will be WIPED COMPLETELY."
  lsblk "$disk" || true
  local confirm
  read -rp "> type ERASE (all caps) to continue, anything else aborts: " confirm
  [[ "$confirm" == "ERASE" ]] || { c_info "aborted — nothing was touched"; exit 0; }

  # ── 3. identity ─────────────────────────────────────────────────────────────
  c_step "Machine identity"
  local hostname
  read -rp "> hostname [foundation]: " hostname
  hostname="${hostname:-foundation}"

  # Console text size (feedback #1): the operator asked to be *asked* at setup,
  # with a 2× default. Applied VT-wide by the session wrapper; changeable later
  # in Settings > TEXT SIZE.
  echo
  echo "Console text size (changeable later in Settings > TEXT SIZE):"
  echo "  1) normal        (8×16)"
  echo "  2) large         (12×24)"
  echo "  3) extra large   (16×32)   [default — 2× normal]"
  local sizepick font="ter-v32b"
  read -rp "> text size [3]: " sizepick
  case "$sizepick" in
    1) font="ter-v16b" ;;
    2) font="ter-v24b" ;;
    *) font="ter-v32b" ;;
  esac
  c_info "text size: $font"
  echo
  echo "Root password: used only at the rescue shell (Ctrl-Alt-F2 / recovery)."
  echo "Leave empty to LOCK the root account (rescue then needs this USB)."
  local rootpw rootpw2
  while :; do
    read_password "> root password (empty = lock): " rootpw
    [[ -z "$rootpw" ]] && break
    read_password "> again: " rootpw2
    [[ "$rootpw" == "$rootpw2" ]] && break
    c_warn "passwords do not match, try again"
  done

  # ── 4. partition + format ───────────────────────────────────────────────────
  c_step "Partitioning $disk"
  local uefi=0
  [[ -d /sys/firmware/efi/efivars ]] && uefi=1
  ((uefi)) && c_info "firmware: UEFI" || c_info "firmware: BIOS/legacy"

  umount -R "$MNT" 2>/dev/null || true
  sgdisk --zap-all "$disk"
  if ((uefi)); then
    sgdisk -n 1:0:+512M -t 1:ef00 -c 1:ESP \
           -n 2:0:0     -t 2:8300 -c 2:root "$disk"
  else
    sgdisk -n 1:0:+1M   -t 1:ef02 -c 1:bios-boot \
           -n 2:0:0     -t 2:8300 -c 2:root "$disk"
  fi
  partprobe "$disk" 2>/dev/null || true
  udevadm settle 2>/dev/null || sleep 2

  local p=""
  [[ "$disk" == *[0-9] ]] && p="p"
  local part1="${disk}${p}1" part2="${disk}${p}2"

  wipefs -a "$part2" >/dev/null 2>&1 || true
  mkfs.ext4 -qF -L foundation-root "$part2"
  mount "$part2" "$MNT"
  if ((uefi)); then
    wipefs -a "$part1" >/dev/null 2>&1 || true
    mkfs.fat -F32 -n FOUNDESP "$part1" >/dev/null
    mkdir -p "$MNT/boot"
    mount "$part1" "$MNT/boot"
  fi
  c_ok "filesystems ready"

  # ── 5. base system (offline repo when the ISO carries one) ─────────────────
  c_step "Installing the base system"
  # base set + everything install/packages.txt names (+ the profile's list) —
  # laid down up front so the OS install steps run with FOUNDATION_OFFLINE=1.
  local pkgs=(base archlinux-keyring mkinitcpio grub efibootmgr)
  mapfile -t -O "${#pkgs[@]}" pkgs < <(
    sed -E 's/#.*$//; s/[[:space:]]+$//; /^[[:space:]]*$/d' \
      "$REPO/install/packages.txt")
  if [[ -n "$profile" && -f "$REPO/profiles/$profile/packages.txt" ]]; then
    mapfile -t -O "${#pkgs[@]}" pkgs < <(
      sed -E 's/#.*$//; s/[[:space:]]+$//; /^[[:space:]]*$/d' \
        "$REPO/profiles/$profile/packages.txt")
  fi

  if [[ -f "$PKGREPO/foundation.db" ]]; then
    c_info "using the ISO's embedded package repo (no network needed)"
    cat > /tmp/foundation-pacstrap.conf <<EOF
[options]
Architecture = x86_64
# Our own offline mirror, populated at ISO build time from signed Arch
# mirrors; the file:// copy itself is not re-signed.
SigLevel = Never
# pacman ≥7 sandboxes retrieval to the `alpm` user, which can't read/write
# root-owned install paths; pointless for a local file:// copy anyway.
DisableSandbox

[foundation]
Server = file://$PKGREPO
EOF
    pacstrap -C /tmp/foundation-pacstrap.conf -K "$MNT" "${pkgs[@]}"
  else
    c_warn "no embedded package repo on this ISO — falling back to the network"
    c_warn "(connect ethernet, or: systemctl start NetworkManager; nmtui)"
    pacstrap -K "$MNT" "${pkgs[@]}"
  fi
  genfstab -U "$MNT" >> "$MNT/etc/fstab"
  c_ok "base system installed"

  # ── 6. system identity in the target ───────────────────────────────────────
  echo "$hostname" > "$MNT/etc/hostname"
  printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$hostname" \
    > "$MNT/etc/hosts"
  echo "en_US.UTF-8 UTF-8" >> "$MNT/etc/locale.gen"
  arch-chroot "$MNT" locale-gen >/dev/null
  echo "LANG=en_US.UTF-8" > "$MNT/etc/locale.conf"
  ln -sf /usr/share/zoneinfo/UTC "$MNT/etc/localtime"
  arch-chroot "$MNT" hwclock --systohc 2>/dev/null || true
  if [[ -n "$rootpw" ]]; then
    printf 'root:%s\n' "$rootpw" | arch-chroot "$MNT" chpasswd
  else
    arch-chroot "$MNT" passwd -l root >/dev/null
    c_warn "root account LOCKED — rescue requires booting this installer USB"
  fi

  # ── 7. Foundation TerminalOS itself ─────────────────────────────────────────
  c_step "Installing Foundation TerminalOS (install/run-all.sh in the target)"
  mkdir -p "$MNT$REPO"
  cp -a "$REPO/." "$MNT$REPO/"
  # mkarchiso strips file modes when it stages the profile airootfs
  # (cp --no-preserve=mode), so the embedded repo's scripts arrive without
  # exec bits — restore them on the copy the chroot is about to run.
  find "$MNT$REPO" -type f \
    \( -name '*.sh' -o -path '*/hardware/*' -o -path '*/usr/local/bin/*' \) \
    -exec chmod +x {} +

  # ── 7b. stage Frank's local AI from the USB onto the TARGET tree ───────────
  # Must run AFTER the repo is on $MNT (disk), never into the live overlay's
  # /opt/terminal-os (that would put ~1.2 GB on tmpfs and risk OOM). install/11
  # then picks vendor/ up from $REPO_ROOT on the installed system.
  c_step "Frank local AI (staged model, if present)"
  stage_frank_ai "$live_disk" "$MNT$REPO"

  arch-chroot "$MNT" /usr/bin/env \
    FOUNDATION_ASSUME_YES=1 FOUNDATION_OFFLINE=1 \
    HARDWARE_PROFILE="$profile" \
    FOUNDATION_CONSOLE_FONT="$font" \
    "$REPO/install/run-all.sh"

  # ── 8. bootloader ───────────────────────────────────────────────────────────
  c_step "Bootloader"
  if ((uefi)); then
    # --removable covers firmware that ignores NVRAM entries (common on mini
    # PCs); the named entry is best-effort on top.
    arch-chroot "$MNT" grub-install --target=x86_64-efi \
      --efi-directory=/boot --bootloader-id=FOUNDATION --removable
    arch-chroot "$MNT" grub-install --target=x86_64-efi \
      --efi-directory=/boot --bootloader-id=FOUNDATION 2>/dev/null || true
  else
    arch-chroot "$MNT" grub-install --target=i386-pc "$disk"
  fi
  arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg
  c_ok "GRUB installed"

  # ── done ────────────────────────────────────────────────────────────────────
  cp "$LOG" "$MNT/var/log/foundation-install.log" 2>/dev/null || true
  sync
  umount -R "$MNT"
  c_step "Installation complete"
  echo "  Remove the installer medium. The machine will boot straight into"
  echo "  the Home Hub login screen. First boot: register the first account"
  echo "  (technician setup code — see docs/USERS.md on the installed system"
  echo "  under $REPO/docs)."
  echo
  local ans
  read -rp "> press ENTER to reboot (or type s for a live shell): " ans
  [[ "${ans,,}" == "s" ]] || reboot
}

main "$@"
