#!/usr/bin/env bash
# foundation-install — runs on the live ISO's console and turns the machine in
# front of you into Foundation TerminalOS.
#
# Flow (one screenful at a time, same register as the OS itself):
#   1. optional hardware profile (default: generic core — any x86_64 box)
#   2. pick the target disk from a menu — the ONE destructive step,
#      gated behind typing ERASE in full
#   3. hostname + root password
#   4. partition, pacstrap from the ISO's embedded offline package repo
#      (network fallback if the ISO was built without one), copy this repo to
#      /opt/terminal-os on the target, run install/run-all.sh in the chroot,
#      install GRUB (UEFI or BIOS), reboot
#
# The installed system never depends on the install-time machine: paths are
# recorded/searched (see /etc/foundationhub/install-root), the operator's home
# is resolved from the passwd db, and the generic core assumes no device.
# -E so the ERR trap fires for failures inside main() (function bodies don't
# inherit the trap without errtrace).
set -Eeuo pipefail

REPO=/opt/terminal-os                 # embedded by image/build-iso.sh
PKGREPO=/opt/foundation/pkgs          # embedded offline package repo (optional)
MNT=/mnt
LOG=/root/foundation-install.log

# ── the terminal voice ───────────────────────────────────────────────────────
c_info()  { printf '\033[1;33m[*]\033[0m %s\n' "$*"; }
c_ok()    { printf '\033[1;32m[+]\033[0m %s\n' "$*"; }
c_warn()  { printf '\033[1;31m[!]\033[0m %s\n' "$*"; }
c_step()  { printf '\n\033[1;36m=== %s ===\033[0m\n' "$*"; }

banner() {
  clear || true
  printf '\033[1;33m'
  cat <<'EOF'
  ┌──────────────────────────────────────────────────────────────┐
  │             FOUNDATION  TERMINALOS  —  INSTALLER             │
  │                     "From the Foundation."                   │
  └──────────────────────────────────────────────────────────────┘
EOF
  printf '\033[0m'
  echo "  This medium installs a locked-down, no-shell kiosk OS with an"
  echo "  always-on overseer (Frank). Ctrl-Alt-F2 gives a rescue shell."
  echo
}

on_error() {
  c_warn "installer stopped on an error (see above; log: $LOG)"
  c_warn "the target may still be mounted at $MNT — you are in the live"
  c_warn "environment, nothing on this machine boots differently yet."
  c_warn "fix and rerun with:  foundation-install"
}
trap on_error ERR

main() {
  exec > >(tee -a "$LOG") 2>&1
  banner
  [[ -d "$REPO/install" ]] || {
    c_warn "embedded repo missing at $REPO — was this ISO built by image/build-iso.sh?"
    exit 1
  }

  # ── 1. hardware profile ────────────────────────────────────────────────────
  c_step "Hardware profile"
  echo "The generic core targets any x86_64 machine (mini PCs included) and"
  echo "assumes no device. A profile adds glue for one specific device only."
  echo
  local profiles=() i=1
  local d
  for d in "$REPO"/profiles/*/; do
    [[ -d "$d" ]] && profiles+=("$(basename "$d")")
  done
  echo "  0) none — generic core (recommended for mini PCs)"
  for d in "${profiles[@]}"; do echo "  $i) $d"; i=$((i + 1)); done
  local pick profile=""
  read -rp "> profile [0]: " pick
  if [[ "$pick" =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#profiles[@]})); then
    profile="${profiles[$((pick - 1))]}"
    c_info "profile: $profile — check $REPO/profiles/$profile/README.md gates after install"
  else
    c_info "generic core only"
  fi

  # ── 2. target disk (the destructive step) ──────────────────────────────────
  c_step "Target disk"
  # Never offer the medium we booted from.
  local live_disk=""
  local live_src
  live_src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -n "$live_src" && -b "$live_src" ]]; then
    live_disk="$(lsblk -no pkname "$live_src" 2>/dev/null | head -1 || true)"
    # A dd'd ISO may be mounted from the whole device, not a partition —
    # pkname is empty then, and the device itself is the disk to exclude.
    [[ -z "$live_disk" ]] && live_disk="$(basename "$live_src")"
  fi

  local disks=() lines=() name size model
  while read -r name size model; do
    [[ -n "$name" ]] || continue
    [[ "$(basename "$name")" == "$live_disk" ]] && continue
    disks+=("$name")
    lines+=("$name  $size  ${model:-}")
  done < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF == "disk" {NF--; print}')

  if ((${#disks[@]} == 0)); then
    c_warn "no installable disks found (only the live medium is present)"
    exit 1
  fi
  echo "Every byte on the chosen disk will be destroyed."
  echo
  i=1
  local l
  for l in "${lines[@]}"; do echo "  $i) $l"; i=$((i + 1)); done
  local disk=""
  while [[ -z "$disk" ]]; do
    read -rp "> install to disk #: " pick
    if [[ "$pick" =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#disks[@]})); then
      disk="${disks[$((pick - 1))]}"
    fi
  done
  echo
  c_warn "TARGET: $disk — this disk will be WIPED COMPLETELY."
  lsblk "$disk" || true
  local confirm
  read -rp "> type ERASE (all caps) to continue, anything else aborts: " confirm
  [[ "$confirm" == "ERASE" ]] || { c_info "aborted — nothing was touched"; exit 0; }

  # ── 3. identity ─────────────────────────────────────────────────────────────
  c_step "Machine identity"
  local hostname
  read -rp "> hostname [foundation]: " hostname
  hostname="${hostname:-foundation}"
  echo
  echo "Root password: used only at the rescue shell (Ctrl-Alt-F2 / recovery)."
  echo "Leave empty to LOCK the root account (rescue then needs this USB)."
  local rootpw rootpw2
  while :; do
    read -rsp "> root password (empty = lock): " rootpw; echo
    [[ -z "$rootpw" ]] && break
    read -rsp "> again: " rootpw2; echo
    [[ "$rootpw" == "$rootpw2" ]] && break
    c_warn "passwords do not match, try again"
  done

  # ── 4. partition + format ───────────────────────────────────────────────────
  c_step "Partitioning $disk"
  local uefi=0
  [[ -d /sys/firmware/efi/efivars ]] && uefi=1
  ((uefi)) && c_info "firmware: UEFI" || c_info "firmware: BIOS/legacy"

  umount -R "$MNT" 2>/dev/null || true
  sgdisk --zap-all "$disk"
  if ((uefi)); then
    sgdisk -n 1:0:+512M -t 1:ef00 -c 1:ESP \
           -n 2:0:0     -t 2:8300 -c 2:root "$disk"
  else
    sgdisk -n 1:0:+1M   -t 1:ef02 -c 1:bios-boot \
           -n 2:0:0     -t 2:8300 -c 2:root "$disk"
  fi
  partprobe "$disk" 2>/dev/null || true
  udevadm settle 2>/dev/null || sleep 2

  local p=""
  [[ "$disk" == *[0-9] ]] && p="p"
  local part1="${disk}${p}1" part2="${disk}${p}2"

  wipefs -a "$part2" >/dev/null 2>&1 || true
  mkfs.ext4 -qF -L foundation-root "$part2"
  mount "$part2" "$MNT"
  if ((uefi)); then
    wipefs -a "$part1" >/dev/null 2>&1 || true
    mkfs.fat -F32 -n FOUNDESP "$part1" >/dev/null
    mkdir -p "$MNT/boot"
    mount "$part1" "$MNT/boot"
  fi
  c_ok "filesystems ready"

  # ── 5. base system (offline repo when the ISO carries one) ─────────────────
  c_step "Installing the base system"
  # base set + everything install/packages.txt names (+ the profile's list) —
  # laid down up front so the OS install steps run with FOUNDATION_OFFLINE=1.
  local pkgs=(base archlinux-keyring mkinitcpio grub efibootmgr)
  mapfile -t -O "${#pkgs[@]}" pkgs < <(
    sed -E 's/#.*$//; s/[[:space:]]+$//; /^[[:space:]]*$/d' \
      "$REPO/install/packages.txt")
  if [[ -n "$profile" && -f "$REPO/profiles/$profile/packages.txt" ]]; then
    mapfile -t -O "${#pkgs[@]}" pkgs < <(
      sed -E 's/#.*$//; s/[[:space:]]+$//; /^[[:space:]]*$/d' \
        "$REPO/profiles/$profile/packages.txt")
  fi

  if [[ -f "$PKGREPO/foundation.db" ]]; then
    c_info "using the ISO's embedded package repo (no network needed)"
    cat > /tmp/foundation-pacstrap.conf <<EOF
[options]
Architecture = x86_64
# Our own offline mirror, populated at ISO build time from signed Arch
# mirrors; the file:// copy itself is not re-signed.
SigLevel = Never
# pacman ≥7 sandboxes retrieval to the `alpm` user, which can't read/write
# root-owned install paths; pointless for a local file:// copy anyway.
DisableSandbox

[foundation]
Server = file://$PKGREPO
EOF
    pacstrap -C /tmp/foundation-pacstrap.conf -K "$MNT" "${pkgs[@]}"
  else
    c_warn "no embedded package repo on this ISO — falling back to the network"
    c_warn "(connect ethernet, or: systemctl start NetworkManager; nmtui)"
    pacstrap -K "$MNT" "${pkgs[@]}"
  fi
  genfstab -U "$MNT" >> "$MNT/etc/fstab"
  c_ok "base system installed"

  # ── 6. system identity in the target ───────────────────────────────────────
  echo "$hostname" > "$MNT/etc/hostname"
  printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$hostname" \
    > "$MNT/etc/hosts"
  echo "en_US.UTF-8 UTF-8" >> "$MNT/etc/locale.gen"
  arch-chroot "$MNT" locale-gen >/dev/null
  echo "LANG=en_US.UTF-8" > "$MNT/etc/locale.conf"
  ln -sf /usr/share/zoneinfo/UTC "$MNT/etc/localtime"
  arch-chroot "$MNT" hwclock --systohc 2>/dev/null || true
  if [[ -n "$rootpw" ]]; then
    printf 'root:%s\n' "$rootpw" | arch-chroot "$MNT" chpasswd
  else
    arch-chroot "$MNT" passwd -l root >/dev/null
    c_warn "root account LOCKED — rescue requires booting this installer USB"
  fi

  # ── 7. Foundation TerminalOS itself ─────────────────────────────────────────
  c_step "Installing Foundation TerminalOS (install/run-all.sh in the target)"
  mkdir -p "$MNT$REPO"
  cp -a "$REPO/." "$MNT$REPO/"
  arch-chroot "$MNT" /usr/bin/env \
    FOUNDATION_ASSUME_YES=1 FOUNDATION_OFFLINE=1 \
    HARDWARE_PROFILE="$profile" \
    "$REPO/install/run-all.sh"

  # ── 8. bootloader ───────────────────────────────────────────────────────────
  c_step "Bootloader"
  if ((uefi)); then
    # --removable covers firmware that ignores NVRAM entries (common on mini
    # PCs); the named entry is best-effort on top.
    arch-chroot "$MNT" grub-install --target=x86_64-efi \
      --efi-directory=/boot --bootloader-id=FOUNDATION --removable
    arch-chroot "$MNT" grub-install --target=x86_64-efi \
      --efi-directory=/boot --bootloader-id=FOUNDATION 2>/dev/null || true
  else
    arch-chroot "$MNT" grub-install --target=i386-pc "$disk"
  fi
  arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg
  c_ok "GRUB installed"

  # ── done ────────────────────────────────────────────────────────────────────
  cp "$LOG" "$MNT/var/log/foundation-install.log" 2>/dev/null || true
  sync
  umount -R "$MNT"
  c_step "Installation complete"
  echo "  Remove the installer medium. The machine will boot straight into"
  echo "  the Home Hub login screen. First boot: register the first account"
  echo "  (technician setup code — see docs/USERS.md on the installed system"
  echo "  under $REPO/docs)."
  echo
  local ans
  read -rp "> press ENTER to reboot (or type s for a live shell): " ans
  [[ "${ans,,}" == "s" ]] || reboot
}

main "$@"
