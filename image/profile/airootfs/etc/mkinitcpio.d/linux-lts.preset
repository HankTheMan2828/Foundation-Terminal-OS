# mkinitcpio preset for the live ISO's linux-lts kernel (archiso image only).
PRESETS=('archiso')

ALL_kver='/boot/vmlinuz-linux-lts'
# mkinitcpio has NO conf.d drop-in mechanism — the archiso hooks apply only
# because this preset points the config at that file explicitly (same wiring
# as releng's preset). With ALL_config='/etc/mkinitcpio.conf' the stock
# config wins and the image gets a generic initramfs that cannot mount the
# live medium at all ("Failed to start Switch Root" on every real machine).
archiso_config='/etc/mkinitcpio.conf.d/archiso.conf'

archiso_image="/boot/initramfs-linux-lts.img"
