# Maintainer: Foundation TerminalOS
# Packages the vendored Rogue 5.4.5 (1985, the authors' finished version)
# source in src/ -- see NOTICE.md for provenance/license. Built by
# image/build-iso.sh at ISO build time and baked into the offline package
# repo; never fetched on the target machine
# (docs/FEEDBACK-FIRST-HARDWARE-RUN.md item 2).
pkgname=rogue5.4
pkgver=5.4.5
pkgrel=1
pkgdesc="Rogue: Exploring the Dungeons of Doom -- 1985 classic vintage (kernel-console/curses)"
arch=('x86_64')
url="https://github.com/RoguelikeRestorationProject/rogue5.4"
license=('BSD')
depends=('ncurses')
makedepends=('gcc' 'make')
# Vendored locally (see src/, NOTICE.md) -- nothing to download or verify.
source=()
sha256sums=()

prepare() {
  cd "$startdir/src"
  # main.c's tstp() (SIGTSTP handler) pokes ncurses' PRIVATE WINDOW fields
  # to restore the cursor after a suspend/resume:
  #     curscr->_cury = oy;  curscr->_curx = ox;
  # Modern ncurses builds with opaque structs, so those members are not
  # addressable and the file no longer compiles. wmove(curscr, oy, ox) is
  # the public API for exactly that operation (set a window's cursor
  # position without redrawing) -- behavior-identical. Applied here at
  # build time so the vendored source itself stays verbatim
  # (docs/FEEDBACK-FIRST-HARDWARE-RUN.md item 2); build-iso.sh copies
  # vendor/ to a throwaway build dir, so nothing in the repo is touched.
  sed -i -e 's/curscr->_cury = oy;/wmove(curscr, oy, ox);/' \
         -e '/curscr->_curx = ox;/d' main.c
}

build() {
  cd "$startdir/src"
  # Binary name "rogue54" avoids colliding with rogue3.6's "rogue". setgid
  # games + an absolute scorefile/lockfile path: upstream's own mechanism for
  # a shared top-ten board (Arch's filesystem package ships a "games" group
  # by default). This is the project's real configure/make -- no game logic
  # patched.
  # CFLAGS additions (appended to makepkg.conf's own CFLAGS, not replacing
  # them): this 1985 K&R-era source shares rogue3.6's function-pointer members
  # declared with the old "unspecified arguments" empty-parameter syntax
  # (rogue.h's `void (*d_func)();`, called with an argument in daemon.c) --
  # under GCC's current default standard (gnu23) that's a hard error, not a
  # warning. -std=gnu17 restores the older semantics without touching the
  # vendored source (docs/FEEDBACK-FIRST-HARDWARE-RUN.md item 2).
  # -Wno-error=implicit-int, -Wno-error=implicit-function-declaration: same
  # two downgrades rogue3.6 needs -- most of this source was ANSI-fied
  # upstream, but pack.c's update_mdest() is still a K&R definition with no
  # return type, and GCC 14+ makes that a hard error in every -std mode
  # (broke the TerminalOS-v0.0.2 release build at ISO build time).
  CFLAGS="$CFLAGS -std=gnu17 -Wno-error=implicit-int -Wno-error=implicit-function-declaration" \
  ./configure --prefix=/usr \
    --with-program-name=rogue54 \
    --enable-setgid=games \
    --enable-scorefile=/var/lib/rogue/rogue54.scr \
    --enable-lockfile=/var/lib/rogue/rogue54.lck
  make
}

package() {
  cd "$startdir/src"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE.TXT "$pkgdir/usr/share/licenses/$pkgname/LICENSE.TXT"
  # `make install` chgrp/chmods the scorefile itself but leaves the enclosing
  # directory at a plain default mode -- fix it up so a lockfile created at
  # runtime also lands in group "games".
  install -dm2775 -g games "$pkgdir/var/lib/rogue"
}
