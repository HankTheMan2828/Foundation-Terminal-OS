#!/usr/bin/env bash
# foundationhub-web — temporary Firefox session for Programs → WEB ACCESS.
#
# Why this exists:
#   The Hub is console-first (curses on the kernel VT, or a profile's
#   cage+kitty stack). Auto-launching a bare GUI browser left operators
#   unable to type or exit (v0.1.1 report). This wrapper opens a *bounded*
#   Wayland kiosk (sway + Firefox), always returns when Firefox exits, and
#   provides keyboard pointer control until a real mouse is wired system-wide.
#
# Pointer (no hardware mouse yet):
#   Alt+←/→/↑/↓     move pointer (coarse)
#   Alt+Shift+arrows fine move
#   Alt+Enter        left click
#   Alt+Backspace    right click
#   Alt+PgUp/PgDn    scroll wheel
# Quit:
#   Ctrl+Q           end session (kill Firefox + exit sway)
#   closing Firefox  also ends the session
#
# Usage: foundationhub-web [URL]
# Env:
#   FOUNDATIONHUB_WEB_URL   default URL if argv empty
#   FOUNDATIONHUB_WEB_NESTED=1  force nested Wayland (parent compositor)
set -euo pipefail

URL="${1:-${FOUNDATIONHUB_WEB_URL:-https://duckduckgo.com}}"

die() { printf 'foundationhub-web: %s\n' "$*" >&2; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing '$1' — install packages: firefox sway seatd"
}

need firefox
need sway

# Runtime dir for the Wayland socket (getty+pam usually sets this; belt+suspenders).
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
  mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || die "no XDG_RUNTIME_DIR ($XDG_RUNTIME_DIR)"
  chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
# Prefer seatd when available (package enabled by install/04).
export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-seatd}"

WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/foundation-web.XXXXXX")"
CONF="$WORKDIR/sway.conf"
URLFILE="$WORKDIR/url.txt"
RUNFF="$WORKDIR/run-firefox.sh"
printf '%s' "$URL" >"$URLFILE"
cleanup() { rm -rf "$WORKDIR"; }
trap cleanup EXIT

# Small runner so the URL never has to be shell-escaped into the sway config.
cat >"$RUNFF" <<'RUN'
#!/bin/sh
set -eu
URL=$(cat "$1")
firefox --new-window "$URL" || true
swaymsg exit 2>/dev/null || true
RUN
chmod 700 "$RUNFF"

# Sway kiosk config: one fullscreen Firefox, keyboard pointer, clean exit.
# Paths are from mktemp — safe to embed literally.
cat >"$CONF" <<EOF
# Generated by foundationhub-web — do not edit by hand.
font pango:monospace 12
default_border none
default_floating_border none
focus_follows_mouse no
titlebar_padding 0
titlebar_border_thickness 0
output * bg #0a0a0a solid_color

# ── Keyboard pointer (hardware mouse is TODO system-wide) ───────────────────
# Coarse
bindsym Alt+Left       seat - cursor move -28 0
bindsym Alt+Right      seat - cursor move 28 0
bindsym Alt+Up         seat - cursor move 0 -28
bindsym Alt+Down       seat - cursor move 0 28
# Fine
bindsym Alt+Shift+Left  seat - cursor move -6 0
bindsym Alt+Shift+Right seat - cursor move 6 0
bindsym Alt+Shift+Up    seat - cursor move 0 -6
bindsym Alt+Shift+Down  seat - cursor move 0 6
# Clicks / scroll
bindsym Alt+Return     seat - cursor press button1, seat - cursor release button1
bindsym Alt+KP_Enter   seat - cursor press button1, seat - cursor release button1
bindsym Alt+BackSpace  seat - cursor press button3, seat - cursor release button3
bindsym Alt+Prior      seat - cursor press button4, seat - cursor release button4
bindsym Alt+Next       seat - cursor press button5, seat - cursor release button5

# Quit the whole Web Access session
bindsym Ctrl+q exec killall -q firefox firefox-bin firefox-esr 2>/dev/null; swaymsg exit
bindsym Ctrl+Q exec killall -q firefox firefox-bin firefox-esr 2>/dev/null; swaymsg exit

# Firefox fills the output; when it exits, leave sway so the Hub resumes.
for_window [app_id="firefox"] border none, fullscreen enable
for_window [app_id="firefox-esr"] border none, fullscreen enable
for_window [class="(?i)firefox"] border none, fullscreen enable

exec $RUNFF $URLFILE
EOF

# Decide nested vs native seat.
# - From the kernel VT (normal core path): no WAYLAND_DISPLAY → native DRM.
# - From a profile display-stack (cage+kitty): prefer a free VT so we do not
#   fight cage for the only client slot; fall back to nested Wayland.
run_sway() {
  # Do not exec — trap must remove $WORKDIR after sway exits.
  # --unsupported-gpu: some iGPU setups need it; harmless when not.
  local rc=0
  if sway --help 2>&1 | grep -q -- '--unsupported-gpu'; then
    sway --unsupported-gpu -c "$CONF" || rc=$?
  else
    sway -c "$CONF" || rc=$?
  fi
  return "$rc"
}

NESTED="${FOUNDATIONHUB_WEB_NESTED:-0}"
PARENT_WL="${WAYLAND_DISPLAY:-}"

if [[ "$NESTED" == "1" ]]; then
  export WLR_BACKENDS=wayland
  run_sway
fi

if [[ -n "$PARENT_WL" ]]; then
  # Already under a compositor. Try a dedicated VT so cage (single-client)
  # is not asked to host a second app.
  if command -v openvt >/dev/null 2>&1; then
    # openvt -s switches; -w waits. -- clears openvt flags for the child.
    # Strip parent display so the child owns DRM on the new VT.
    if openvt -s -w -- env -u WAYLAND_DISPLAY -u DISPLAY \
         FOUNDATIONHUB_WEB_NESTED=0 \
         XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
         MOZ_ENABLE_WAYLAND=1 \
         LIBSEAT_BACKEND="$LIBSEAT_BACKEND" \
         "$0" "$URL"
    then
      exit 0
    fi
    # openvt often needs root — fall through to nested attempt.
  fi
  # Nested sway as a Wayland client of the parent (works on multi-client
  # compositors; may fail under cage — error is visible, Hub still resumes).
  export WLR_BACKENDS=wayland
  run_sway
fi

# Core path: Hub on kernel VT, Launch suspended curses — take the seat.
unset WAYLAND_DISPLAY DISPLAY || true
run_sway
