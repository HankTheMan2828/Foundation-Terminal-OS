#!/usr/bin/env bash
# foundationhub-web — temporary Firefox session for Programs → WEB ACCESS.
#
# The Hub is console-first (curses on a kernel VT). This wrapper must:
#   1. Start a real graphical Firefox session
#   2. Always return to the Hub when the browser exits
#   3. Provide keyboard pointer control when the compositor supports it
#   4. Fall back to w3m only after every graphical path has failed
#
# Pointer (sway path):
#   Alt+arrows move · Alt+Shift+arrows fine · Alt+Enter click · Ctrl+Q quit
# On the Xorg path, use Firefox's own keyboard UI (Ctrl+L, Tab, Enter) until
# a system-wide mouse exists.
#
# Usage: foundationhub-web [URL]
# Env:
#   FOUNDATIONHUB_WEB_URL, FOUNDATIONHUB_WEB_LOG, FOUNDATIONHUB_WEB_NESTED,
#   FOUNDATIONHUB_WEB_NO_FALLBACK=1
# Diagnostics: ~/.local/state/foundationhub-web.log (persistent — survives
# the reboot a stuck console forces, unlike the old /run/user location).
set -u

URL="${1:-${FOUNDATIONHUB_WEB_URL:-https://duckduckgo.com}}"

# ── logging ────────────────────────────────────────────────────────────────
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [[ ! -d "${XDG_RUNTIME_DIR}" ]]; then
  mkdir -p "${XDG_RUNTIME_DIR}" 2>/dev/null || true
  chmod 700 "${XDG_RUNTIME_DIR}" 2>/dev/null || true
fi

# Log to PERSISTENT state, not /run/user: that's tmpfs, and the failure mode
# being diagnosed forces the operator to reboot — which wiped the evidence
# every time. Keep in sync with app.py launch() (it points the Hub here).
STATE_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}"
mkdir -p "$STATE_DIR" 2>/dev/null || true
LOG="${FOUNDATIONHUB_WEB_LOG:-${STATE_DIR}/foundationhub-web.log}"
if ! ( : >>"$LOG" ) 2>/dev/null; then
  LOG="${XDG_RUNTIME_DIR}/foundationhub-web.log"
fi
if ! ( : >>"$LOG" ) 2>/dev/null; then
  LOG="/tmp/foundationhub-web-$UID.log"
fi
export FOUNDATIONHUB_WEB_LOG="$LOG"
: >"$LOG" 2>/dev/null || true

log()  { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" | tee -a "$LOG" >&2; }
fail() { log "ERROR: $*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# ── binaries ───────────────────────────────────────────────────────────────
FIREFOX=""
if have firefox; then
  FIREFOX="$(command -v firefox)"
elif have firefox-esr; then
  FIREFOX="$(command -v firefox-esr)"
else
  fail "firefox not installed — need package: firefox (USB update installs it)"
fi

# Dedicated profile so a stale lock from a crashed session cannot block us.
PROFILE="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/foundationhub-firefox"
mkdir -p "$PROFILE" 2>/dev/null || PROFILE="/tmp/foundationhub-firefox-$UID"
mkdir -p "$PROFILE" 2>/dev/null || true
# Clear stuck locks from a previous one-frame crash.
rm -f "$PROFILE"/.parentlock "$PROFILE"/lock "$PROFILE"/*.lock 2>/dev/null || true

log "start url=$URL user=$(id -un) vt=${XDG_VTNR:-?} firefox=${FIREFOX:-none} profile=$PROFILE runtime=$XDG_RUNTIME_DIR"

# Compatibility defaults — console/kiosk boxes often lack a full GPU stack.
export MOZ_WEBRENDER="${MOZ_WEBRENDER:-0}"
export MOZ_ACCELERATED="${MOZ_ACCELERATED:-0}"
export MOZ_DISABLE_RDD_SANDBOX="${MOZ_DISABLE_RDD_SANDBOX:-1}"
export MOZ_DISABLE_CONTENT_SANDBOX="${MOZ_DISABLE_CONTENT_SANDBOX:-1}"

# A failed/killed Xorg or compositor can leave the VT in KD_GRAPHICS with a
# raw keyboard — the console then LOOKS dead (black, no echo) even though the
# Hub is still running, and the operator power-cycles (v0.1.5 hardware
# report). Force the VT back to text mode before w3m and on every exit.
# KDSETMODE=0x4B3A (KD_TEXT=0) · KDSKBMODE=0x4B45 (K_UNICODE=3).
vt_reset() {
  if have python3; then
    python3 - <<'PY' 2>/dev/null || true
import fcntl, os
try:
    fd = os.open("/dev/tty", os.O_RDWR)
except OSError:
    raise SystemExit(0)
for req, arg in ((0x4B3A, 0), (0x4B45, 3)):
    try:
        fcntl.ioctl(fd, req, arg)
    except OSError:
        pass
PY
  fi
  stty sane 2>/dev/null || true
  # Full terminal reset (also clears any half-drawn graphics frame). The Hub
  # re-applies its palette after every launch (theme.dress_console).
  printf '\033c' >/dev/tty 2>/dev/null || true
}

WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/foundation-web.XXXXXX")"
cleanup() { vt_reset; rm -rf "$WORKDIR" 2>/dev/null || true; }
trap cleanup EXIT

URLFILE="$WORKDIR/url.txt"
FFRC_FILE="$WORKDIR/firefox.rc"
printf '%s' "$URL" >"$URLFILE"

# Shared Firefox launcher used by sway/cage/xorg paths.
# Arg1 = mode: wayland | x11 | auto
# Arg2 = url file
RUNFF="$WORKDIR/run-firefox.sh"
cat >"$RUNFF" <<RUN
#!/bin/sh
set -u
LOG="\${FOUNDATIONHUB_WEB_LOG:-/dev/null}"
MODE="\${1:-auto}"
URL=\$(cat "\$2")
FF="\${FIREFOX_BIN:-firefox}"
PROFILE="$PROFILE"
FFRC_FILE="$FFRC_FILE"

{
  echo "firefox-launch mode=\$MODE bin=\$FF"
  echo "  WAYLAND_DISPLAY=\${WAYLAND_DISPLAY:-} DISPLAY=\${DISPLAY:-}"
  echo "  XDG_RUNTIME_DIR=\${XDG_RUNTIME_DIR:-}"
  echo "  profile=\$PROFILE url=\$URL"
} >>"\$LOG" 2>&1

# Wait briefly for a display socket (compositor just came up).
i=0
while [ "\$i" -lt 50 ]; do
  if [ -n "\${WAYLAND_DISPLAY:-}" ] || [ -n "\${DISPLAY:-}" ]; then
    break
  fi
  i=\$((i + 1))
  sleep 0.1
done

case "\$MODE" in
  wayland)
    export MOZ_ENABLE_WAYLAND=1
    export GDK_BACKEND=wayland
    ;;
  x11)
    export MOZ_ENABLE_WAYLAND=0
    export GDK_BACKEND=x11
    # Xwayland may need a moment after sway/cage starts.
    j=0
    while [ "\$j" -lt 30 ] && [ -z "\${DISPLAY:-}" ]; do
      j=\$((j + 1))
      sleep 0.1
    done
    ;;
  auto)
    if [ -n "\${WAYLAND_DISPLAY:-}" ]; then
      export MOZ_ENABLE_WAYLAND=1
    else
      export MOZ_ENABLE_WAYLAND=0
      export GDK_BACKEND=x11
    fi
    ;;
esac

export MOZ_WEBRENDER=0
export MOZ_ACCELERATED=0
export LIBGL_ALWAYS_SOFTWARE="\${LIBGL_ALWAYS_SOFTWARE:-1}"

run_ff() {
  # Prefer an existing session bus (parent may already be under dbus-run-session).
  set -- "\$FF" --profile "\$PROFILE" --new-instance "\$URL"
  if [ -n "\${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    "\$@"
  elif command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- "\$@"
  else
    "\$@"
  fi
}

run_ff >>"\$LOG" 2>&1
rc=\$?
echo "\$rc" >"\$FFRC_FILE"
if [ "\$rc" -ne 0 ]; then
  echo "ERROR: firefox exited rc=\$rc (mode=\$MODE)" >>"\$LOG"
else
  echo "firefox-exit: clean mode=\$MODE" >>"\$LOG"
fi

# Tear down the compositor so the Hub can reclaim the VT. Only sway needs an
# explicit exit (its exec'd child ending does not end the session). cage and
# xinit both terminate on their own when this script (their client) exits —
# the old killall of cage/Xorg yanked the server down mid-teardown and could
# strand the VT in graphics mode (console looked dead until reboot).
if [ -n "\${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null 2>&1; then
  swaymsg exit 2>/dev/null || true
fi
exit "\$rc"
RUN
chmod 700 "$RUNFF"
export FIREFOX_BIN="${FIREFOX:-firefox}"

# Run a command under a session dbus (Firefox aborts without one on a raw VT).
run_dbus() {
  if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    "$@"
  elif have dbus-run-session; then
    dbus-run-session -- "$@"
  else
    "$@"
  fi
}

# Run a Wayland compositor with a working seat + dbus.
#
# Seat policy (v0.1.6): install/04 enables the SYSTEM seatd.service and puts
# the operator in group `seat` — libseat in sway/cage connects to it directly.
# v0.1.4 wrapped every attempt in seatd-launch, but with the system daemon
# already bound a second (user-level, non-root) seatd fails immediately and
# took EVERY GUI path down with it → always w3m (v0.1.5 hardware report).
# seatd-launch is now only a fallback for when no system seatd is running.
run_gui() {
  local -a cmd=("$@")
  if [[ -S /run/seatd.sock ]]; then
    export SEATD_SOCK="${SEATD_SOCK:-/run/seatd.sock}"
    log "using system seatd at ${SEATD_SOCK}"
  elif have seatd-launch; then
    log "no system seatd — using seatd-launch"
    cmd=(seatd-launch -- "${cmd[@]}")
  else
    log "no seatd — relying on logind seat"
  fi
  run_dbus "${cmd[@]}"
}

read_ffrc() {
  if [[ -f "$FFRC_FILE" ]]; then
    cat "$FFRC_FILE" 2>/dev/null || echo 1
  else
    echo ""
  fi
}

# ── sway (keyboard pointer) ────────────────────────────────────────────────
write_sway_conf() {
  local conf="$1" mode="$2"
  cat >"$conf" <<EOF
# Generated by foundationhub-web — do not edit.
font pango:monospace 12
default_border none
default_floating_border none
focus_follows_mouse no
xwayland enable
output * bg #0a0a0a solid_color

bindsym Alt+Left        seat - cursor move -28 0
bindsym Alt+Right       seat - cursor move 28 0
bindsym Alt+Up          seat - cursor move 0 -28
bindsym Alt+Down        seat - cursor move 0 28
bindsym Alt+Shift+Left  seat - cursor move -6 0
bindsym Alt+Shift+Right seat - cursor move 6 0
bindsym Alt+Shift+Up    seat - cursor move 0 -6
bindsym Alt+Shift+Down  seat - cursor move 0 6
bindsym Alt+Return      seat - cursor press button1, seat - cursor release button1
bindsym Alt+KP_Enter    seat - cursor press button1, seat - cursor release button1
bindsym Alt+BackSpace   seat - cursor press button3, seat - cursor release button3
bindsym Alt+Prior       seat - cursor press button4, seat - cursor release button4
bindsym Alt+Next        seat - cursor press button5, seat - cursor release button5

bindsym Ctrl+q exec sh -c 'killall -q firefox firefox-bin firefox-esr 2>/dev/null; swaymsg exit'
bindsym Ctrl+Q exec sh -c 'killall -q firefox firefox-bin firefox-esr 2>/dev/null; swaymsg exit'

for_window [app_id="firefox"] border none, fullscreen enable
for_window [app_id="firefox-esr"] border none, fullscreen enable
for_window [class="(?i)firefox"] border none, fullscreen enable

# Brief delay so the compositor finishes DRM setup before Firefox starts.
exec sh -c 'sleep 0.4; env FIREFOX_BIN='"'$FIREFOX_BIN'"' FOUNDATIONHUB_WEB_LOG='"'$LOG'"' LIBGL_ALWAYS_SOFTWARE=1 '"'$RUNFF'"' '"'$mode'"' '"'$URLFILE'"'
EOF
}

try_sway() {
  local mode="${1:-wayland}"
  have sway || { fail "sway not installed"; return 127; }
  [[ -n "$FIREFOX" ]] || return 127

  local conf="$WORKDIR/sway-$mode.conf"
  write_sway_conf "$conf" "$mode"
  log "trying sway mode=$mode renderer=${WLR_RENDERER:-default} backends=${WLR_BACKENDS:-drm}"

  local -a scmd=(sway)
  if sway --help 2>&1 | grep -q -- '--unsupported-gpu'; then
    scmd+=(--unsupported-gpu)
  fi
  scmd+=(-d -c "$conf")

  if sway --help 2>&1 | grep -qE -- '(^|[[:space:]])-C([[:space:]]|,|$)'; then
    if ! sway -C -c "$conf" >>"$LOG" 2>&1; then
      fail "sway config invalid (mode=$mode)"
      return 1
    fi
  fi

  rm -f "$FFRC_FILE"
  # -d debug logs to stderr → our log
  run_gui "${scmd[@]}" >>"$LOG" 2>&1
  local rc=$?
  local ffrc
  ffrc="$(read_ffrc)"
  log "sway done mode=$mode sway_rc=$rc firefox_rc=${ffrc:-none}"
  if [[ -n "$ffrc" ]]; then
    if [[ "$ffrc" == "0" ]]; then
      return 0
    fi
    fail "firefox failed under sway ($mode) rc=$ffrc"
    return "$ffrc"
  fi
  [[ $rc -eq 0 ]] || fail "sway failed rc=$rc mode=$mode"
  return "$rc"
}

# ── cage (simple kiosk) ────────────────────────────────────────────────────
try_cage() {
  local mode="${1:-auto}"
  have cage || { fail "cage not installed"; return 127; }
  [[ -n "$FIREFOX" ]] || return 127
  log "trying cage mode=$mode"
  unset WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
  rm -f "$FFRC_FILE"

  local -a cargs=(cage)
  # -x enables XWayland when the build supports it (helps Firefox).
  if cage --help 2>&1 | grep -q -- ' -x'; then
    cargs+=(-x)
  fi
  cargs+=(-- env FIREFOX_BIN="$FIREFOX" FOUNDATIONHUB_WEB_LOG="$LOG" \
    LIBGL_ALWAYS_SOFTWARE=1 "$RUNFF" "$mode" "$URLFILE")

  run_gui "${cargs[@]}" >>"$LOG" 2>&1
  local rc=$?
  local ffrc
  ffrc="$(read_ffrc)"
  log "cage done mode=$mode cage_rc=$rc firefox_rc=${ffrc:-none}"
  if [[ -n "$ffrc" ]]; then
    [[ "$ffrc" == "0" ]] && return 0
    fail "firefox failed under cage ($mode) rc=$ffrc"
    return "$ffrc"
  fi
  return "$rc"
}

# ── Xorg + xinit (most reliable from a raw VT) ─────────────────────────────
try_xorg() {
  [[ -n "$FIREFOX" ]] || return 127
  local XBIN=""
  if have Xorg; then
    XBIN="$(command -v Xorg)"
  elif have X; then
    XBIN="$(command -v X)"
  else
    fail "Xorg not installed — need package: xorg-server"
    return 127
  fi
  if ! have xinit; then
    fail "xinit not installed — need package: xorg-xinit"
    return 127
  fi

  local vt="${XDG_VTNR:-1}"
  # Pick a free display number.
  local d=1
  while [[ -e "/tmp/.X${d}-lock" || -e "/tmp/.X11-unix/X${d}" ]]; do
    d=$((d + 1))
    [[ $d -lt 20 ]] || break
  done

  local xinitrc="$WORKDIR/xinitrc"
  cat >"$xinitrc" <<EOF
#!/bin/sh
set -u
export DISPLAY=:$d
export MOZ_ENABLE_WAYLAND=0
export GDK_BACKEND=x11
export MOZ_WEBRENDER=0
export MOZ_ACCELERATED=0
export LIBGL_ALWAYS_SOFTWARE=1
export FOUNDATIONHUB_WEB_LOG="$LOG"
# Optional: X11 mousekeys on keypad (NumLock) if xkbset exists.
command -v xkbset >/dev/null 2>&1 && xkbset m 2>/dev/null || true
# Keep a black root so a failed client is obvious.
command -v xsetroot >/dev/null 2>&1 && xsetroot -solid '#0a0a0a' 2>/dev/null || true
exec env FIREFOX_BIN="$FIREFOX" "$RUNFF" x11 "$URLFILE"
EOF
  chmod 700 "$xinitrc"

  log "trying Xorg display=:$d vt=$vt bin=$XBIN"
  rm -f "$FFRC_FILE"
  # -keeptty: stay on this VT (Hub already suspended curses).
  # Plain dbus only — Xorg does not speak libseat, so the old seatd-launch
  # wrapper added nothing but a way for the whole attempt to fail.
  run_dbus xinit "$xinitrc" -- "$XBIN" ":$d" "vt${vt}" \
    -nolisten tcp -keeptty >>"$LOG" 2>&1
  local rc=$?
  local ffrc
  ffrc="$(read_ffrc)"
  log "xorg done xinit_rc=$rc firefox_rc=${ffrc:-none}"
  if [[ -n "$ffrc" ]]; then
    [[ "$ffrc" == "0" ]] && return 0
    fail "firefox failed under Xorg rc=$ffrc"
    return "$ffrc"
  fi
  [[ $rc -eq 0 ]] || fail "Xorg/xinit failed rc=$rc"
  return "$rc"
}

# ── text fallback ──────────────────────────────────────────────────────────
fallback_w3m() {
  [[ "${FOUNDATIONHUB_WEB_NO_FALLBACK:-0}" == "1" ]] && return 1
  local html="https://html.duckduckgo.com/html/"
  local target="$URL"
  case "$URL" in
    https://duckduckgo.com|https://duckduckgo.com/|http://duckduckgo.com|http://duckduckgo.com/)
      target="$html" ;;
  esac
  for b in w3m lynx links elinks; do
    if have "$b"; then
      fail "all GUI paths failed — falling back to $b (see $LOG)"
      log "fallback: $b $target"
      # The failed GUI attempts above may have left the VT in graphics/raw
      # mode — w3m would render into an invisible console ("barely works").
      vt_reset
      "$b" "$target"
      return $?
    fi
  done
  fail "no GUI and no text browser"
  return 1
}

# ── strategy ───────────────────────────────────────────────────────────────
# Nested under an existing Wayland session (hardware profile display-stack).
if [[ "${FOUNDATIONHUB_WEB_NESTED:-0}" == "1" || -n "${WAYLAND_DISPLAY:-}" ]]; then
  if [[ -n "${WAYLAND_DISPLAY:-}" && "${FOUNDATIONHUB_WEB_NESTED:-0}" != "1" ]] && have openvt; then
    log "parent wayland session — openvt dedicated seat"
    if openvt -s -w -- env -u WAYLAND_DISPLAY -u DISPLAY \
        FOUNDATIONHUB_WEB_NESTED=0 \
        FOUNDATIONHUB_WEB_LOG="$LOG" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        "$0" "$URL" >>"$LOG" 2>&1
    then
      exit 0
    fi
    log "openvt failed — nested attempt"
  fi
  export WLR_BACKENDS=wayland
  try_sway wayland && exit 0
  try_sway x11 && exit 0
  fallback_w3m
  exit $?
fi

# Core: Hub on kernel VT.
unset WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
unset WLR_BACKENDS 2>/dev/null || true

# 1) Xorg first — historically the most reliable "GUI from a VT" path.
try_xorg && exit 0

# 2) cage + XWayland (simple single-app compositor).
try_cage x11 && exit 0
try_cage wayland && exit 0

# 3) sway with keyboard pointer (native Wayland, then X11 client).
try_sway wayland && exit 0
try_sway x11 && exit 0

# 4) sway software renderer.
log "retry sway with WLR_RENDERER=pixman"
export WLR_RENDERER=pixman
export LIBGL_ALWAYS_SOFTWARE=1
try_sway x11 && exit 0
try_sway wayland && exit 0
unset WLR_RENDERER

# 5) Text only after every graphical attempt failed.
fallback_w3m
exit $?
