#!/usr/bin/env python3
"""foundationhub-account — ROOT helper for account provisioning (docs/USERS.md).

The registry (/etc/foundationhub/users.json) is root-owned: the Hub can read it to
list accounts and verify passwords, but cannot write it. All mutation goes
through this helper, invoked from the login screen's registration flow via
pkexec (see /etc/polkit-1/rules.d/50-foundationhub-account.rules).

    foundationhub-account create <username> <tier-int>
        stdin line 1: password
        stdin line 2: technician setup code (may be empty for GUEST)

This is the authoritative validation point — the Hub pre-checks for nicer UX,
but a hostile client talking straight to pkexec hits the same checks here:
capacity (8), username rules, tier's setup-code requirement.

Besides the registry entry it also provisions the underlying system pieces:
  * a real Linux user for the account            [TODO(hardware) verify]
  * the tier's fixed storage quota               [TODO(hardware) — needs a
    quota-enabled filesystem; setquota is attempted, failure is reported but
    not fatal so off-target testing still works]
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys

try:
    import pwd
except ImportError:          # non-POSIX dev box; system-user provisioning skipped
    pwd = None               # type: ignore[assignment]

# The registry logic lives in the Hub package so helper and Hub can never
# disagree about the schema. Resolution order — searched, never assumed, so
# this works wherever the OS was installed:
#   1. the normally-installed foundationhub package (site-packages, install/04)
#   2. $FOUNDATIONHUB_LIB (explicit override)
#   3. the install root recorded by install/04 in /etc/foundationhub/install-root
#   4. /opt/terminal-os — the conventional clone path, as a last resort
def _locate_hub_lib() -> None:
    try:
        import foundationhub  # noqa: F401  — already importable, nothing to do
        return
    except ImportError:
        pass
    candidates = []
    if os.environ.get("FOUNDATIONHUB_LIB"):
        candidates.append(os.environ["FOUNDATIONHUB_LIB"])
    try:
        root = open("/etc/foundationhub/install-root").read().strip()
        if root:
            candidates.append(os.path.join(root, "hub"))
    except OSError:
        pass
    candidates.append("/opt/terminal-os/hub")
    for cand in candidates:
        if os.path.isdir(os.path.join(cand, "foundationhub")):
            sys.path.insert(0, cand)
            return
    sys.exit("foundationhub-account: cannot locate the foundationhub package "
             "(tried site-packages, $FOUNDATIONHUB_LIB, "
             "/etc/foundationhub/install-root, /opt/terminal-os/hub)")


_locate_hub_lib()

from foundationhub.accounts import Registry, RegistryError, Tier, TIERS  # noqa: E402

REGISTRY_GROUP = os.environ.get("FOUNDATIONHUB_OPERATOR", "operator")


def _fail(msg: str) -> int:
    print(msg, file=sys.stderr)
    return 1


def _provision_system_user(username: str, tier: Tier) -> None:
    """Create the Linux user + quota behind the logical account."""
    if pwd is None or shutil.which("useradd") is None:
        return   # off-target dev box
    try:
        pwd.getpwnam(username)
        return   # already exists (idempotent re-run)
    except KeyError:
        pass
    subprocess.run(["useradd", "-m", "-s", "/usr/sbin/nologin", username],
                   check=True)
    # Fixed per-tier allotment (docs/USERS.md). Block quota only; soft=hard —
    # "a set amount of storage, no more no less".
    blocks = TIERS[tier].quota_bytes // 1024
    res = subprocess.run(
        ["setquota", "-u", username, str(blocks), str(blocks), "0", "0", "/home"],
        capture_output=True, text=True)
    if res.returncode != 0:   # TODO(hardware): quota-enabled /home on target
        print(f"warning: quota not applied ({res.stderr.strip()})",
              file=sys.stderr)


def cmd_create(username: str, tier_raw: str) -> int:
    if os.name == "posix" and os.geteuid() != 0:
        return _fail("foundationhub-account must run as root (via pkexec)")
    try:
        tier = Tier(int(tier_raw))
    except ValueError:
        return _fail(f"unknown tier {tier_raw!r}")
    password = sys.stdin.readline().rstrip("\n")
    setup_code = sys.stdin.readline().rstrip("\n")

    registry = Registry()
    try:
        registry.add_account(username, password, tier, setup_code=setup_code)
    except RegistryError as exc:
        return _fail(str(exc))
    # Hub (operator) reads the registry; only root writes it.
    try:
        shutil.chown(registry.path, "root", REGISTRY_GROUP)
        os.chmod(registry.path, 0o640)
    except (OSError, LookupError):
        pass
    try:
        _provision_system_user(username, tier)
    except subprocess.CalledProcessError as exc:
        return _fail(f"registry updated but system user failed: {exc}")
    print(f"account {username} registered ({TIERS[tier].label})")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) == 4 and argv[1] == "create":
        return cmd_create(argv[2], argv[3])
    return _fail(__doc__.strip().splitlines()[0]
                 + "\nusage: foundationhub-account create <username> <tier-int>")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
