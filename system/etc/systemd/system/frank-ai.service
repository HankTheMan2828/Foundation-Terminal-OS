# Frank — the LOCAL AI sensor (IBM Granite Guardian) inference server.
# Operator decision (2026-07-06): the AI runs locally, installed with the OS —
# see docs/FRANK-AI-GUARDIAN.md. Serves an OpenAI-compatible endpoint on
# 127.0.0.1:8080 that Frank's LocalGuardianSifter/GuardianAdvisor talk to. Runs
# as the isolated `frank` user, bound to loopback, RAM-capped so it leaves the
# system its headroom (operator target: <=6 GB for the model, >=2 GB for the OS).
#
# ExecCondition means: if the model file isn't present (e.g. an offline install
# that didn't stage the GGUF), the server simply doesn't start and Frank's
# sensor safely reads nothing — the rules keep running either way.
[Unit]
Description=Frank local AI sensor (Granite Guardian) inference server
After=network.target
Before=frankd.service
Wants=frankd.service

[Service]
Type=simple
User=frank
Group=frank
ExecCondition=/usr/bin/test -f /var/lib/frank/models/guardian.gguf
ExecStart=/usr/bin/llama-server \
  --model /var/lib/frank/models/guardian.gguf \
  --host 127.0.0.1 --port 8080 --ctx-size 2048
Restart=always
RestartSec=3

# Keep the model within the operator's RAM budget (<=6 GB for AI, >=2 GB free).
MemoryMax=6G

# Isolation / hardening. The operator has no path to this process; it also can
# only ever talk to loopback — the sensor must never phone home.
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/frank/models
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
