# Frank — the LOCAL AI sensor inference server.
# Operator decision (2026-07-06): the AI runs locally, installed with the OS —
# see docs/FRANK-LOCAL-AI.md. Serves an OpenAI-compatible endpoint on
# 127.0.0.1:8080 that Frank's LocalSifter/ModelAdvisor *and* the Hub Assistant
# talk to. Runs as the isolated `frank` user, bound to loopback, RAM-capped so
# it leaves the system its headroom (operator target: <=6 GB for the model,
# >=2 GB for the OS).
#
# Current model: BitNet b1.58 2B4T, served by bitnet.cpp's `llama-server` (a
# llama.cpp fork with the 1-bit kernels). The binary + model are laid down by
# install/11-frank-ai.sh. The model is swappable — point the paths at any GGUF a
# compatible llama-server can serve.
#
# ExecCondition means: if the server binary or model file isn't present (e.g. an
# offline install that didn't stage them) the unit stays inactive and Frank's
# sensor / the Hub assistant safely no-op — the rules keep running either way.
[Unit]
Description=Frank local AI sensor (BitNet) inference server
Documentation=file:///opt/terminal-os/docs/FRANK-LOCAL-AI.md
# Loopback only — do not wait on real network. Start after local filesystems so
# /var/lib/frank/models is mounted.
After=local-fs.target
Before=frankd.service
Wants=frankd.service

[Service]
Type=simple
User=frank
Group=frank
# Both assets required. Missing either → unit never starts (not a crash loop).
# Runtime is a directory: llama-server + libllama/libggml (RPATH=$ORIGIN); the
# LD_LIBRARY_PATH is belt-and-braces if patchelf wasn't applied on the build host.
ExecCondition=/usr/bin/test -x /usr/local/lib/foundation-ai/llama-server
ExecCondition=/usr/bin/test -f /var/lib/frank/models/model.gguf
Environment=LD_LIBRARY_PATH=/usr/local/lib/foundation-ai
WorkingDirectory=/usr/local/lib/foundation-ai
# Quiet, single-slot server on loopback. --threads left default so bitnet.cpp
# picks a sane core count; MemoryMax caps the process either way.
ExecStart=/usr/local/lib/foundation-ai/llama-server \
  --model /var/lib/frank/models/model.gguf \
  --host 127.0.0.1 \
  --port 8080 \
  --ctx-size 2048
# Model load can take tens of seconds on first boot; don't mark the unit failed
# while weights are still mapping.
TimeoutStartSec=180
Restart=on-failure
RestartSec=5
# Prefer killing the AI under memory pressure over the Hub / frankd.
OOMScoreAdjust=500

# Keep the model within the operator's RAM budget (<=6 GB for AI, >=2 GB free).
MemoryMax=6G

# Isolation / hardening. The operator has no path to this process; it also can
# only ever talk to loopback — the sensor must never phone home.
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/frank/models /usr/local/lib/foundation-ai
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
